{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threads-downloader-test",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "EXPECTED_HOST": "session.test",
    "EXPECTED_ORIGIN": "https://session.test",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IP_RATE_LIMITS",
        "class_name": "IpRateLimiter",
      },
      {
        "name": "SESSIONS",
        "class_name": "SessionCoordinator",
      },
      {
        "name": "TURNSTILE_REPLAYS",
        "class_name": "TurnstileReplay",
      },
    ],
  },
  "exports": {
    "IpRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "SessionCoordinator": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "TurnstileReplay": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
