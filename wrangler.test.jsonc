{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threads-downloader-test",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "EXPECTED_HOST": "session.test",
    "EXPECTED_ORIGIN": "https://session.test",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionCoordinator",
      },
    ],
  },
  "exports": {
    "SessionCoordinator": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
