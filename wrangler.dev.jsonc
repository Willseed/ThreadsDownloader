{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threads-downloader-dev",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["SESSION_SIGNING_KEY", "TURNSTILE_SECRET"],
  },
  "vars": {
    "EXPECTED_HOST": "localhost",
    "EXPECTED_ORIGIN": "http://localhost:8787",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
  "assets": {
    "directory": "./dist/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IP_RATE_LIMITS",
        "class_name": "IpRateLimiter",
      },
      {
        "name": "SESSIONS",
        "class_name": "SessionCoordinator",
      },
      {
        "name": "TURNSTILE_REPLAYS",
        "class_name": "TurnstileReplay",
      },
    ],
  },
  "exports": {
    "IpRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "SessionCoordinator": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "TurnstileReplay": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
