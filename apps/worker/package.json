{
  "name": "@threads-downloader/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --config ../../wrangler.jsonc",
    "test": "npm run test:unit && npm run test:do",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:do": "vitest run --config vitest.do.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.1.0",
    "@threads-downloader/contracts": "file:../../packages/contracts",
    "hono": "4.12.32"
  }
}
