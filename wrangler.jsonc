{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threads-downloader",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": [
      "DOWNLOAD_ENCRYPTION_KEY",
      "RESOLVED_MEDIA_GRANT_KEY",
      "SESSION_SIGNING_KEY",
      "TURNSTILE_SECRET",
    ],
  },
  "vars": {
    "EXPECTED_HOST": "threads.pylot.dev",
    "EXPECTED_ORIGIN": "https://threads.pylot.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD9Gx9nArUYJAkKJ",
  },
  "assets": {
    "directory": "./dist/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "browser": {
    "binding": "BROWSER",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DOWNLOAD_SESSIONS",
        "class_name": "DownloadSession",
      },
      {
        "name": "IP_RATE_LIMITS",
        "class_name": "IpRateLimiter",
      },
      {
        "name": "SESSIONS",
        "class_name": "SessionCoordinator",
      },
      {
        "name": "TURNSTILE_REPLAYS",
        "class_name": "TurnstileReplay",
      },
    ],
  },
  "exports": {
    "DownloadSession": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "IpRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "SessionCoordinator": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "TurnstileReplay": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
